# Supabase — PUBLIC values only (safe to expose in the browser).
# Copy this file to ".env.local" and fill in your key.
# NEVER put the service_role / secret key in any committed file.
#
# The key can be EITHER your "publishable" key (sb_publishable_...) OR the
# legacy "anon" JWT key (eyJ...). Set it under either name below — the app
# accepts both. Find it in: Supabase Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://iiathuvpstbqrtsskppq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE_YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY_HERE

# ─────────────────────────────────────────────────────────────────────────────
# SERVER-ONLY secrets (never shipped to the browser). Required for adding users
# from the website and for the ZKTeco attendance webhook. Set these in
# .env.local AND in Vercel → Settings → Environment Variables. Do NOT commit
# real values.
#
# Supabase service_role / secret key (Dashboard → Project Settings → API).
# Either name works; this project already uses NEXT_SECRET_SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY=PASTE_YOUR_SERVICE_ROLE_SECRET_KEY_HERE
#
# Shared secret for the ZKTeco agent (zk_agent.py) → /api/zk-attendance.
# Pick any long random string; use the same value in zk_agent.py.
# ZK_API_KEY=PASTE_A_LONG_RANDOM_SECRET_HERE
